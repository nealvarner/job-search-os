# Personal data — never commit
data/*
!data/.gitkeep
briefings/*
!briefings/.gitkeep
pipeline/*
!pipeline/.gitkeep

# Local config that may contain tokens or paths
.env
.env.local
.claude/settings.local.json
config.local.yaml
*.local.yaml

# OS / editor noise
.DS_Store
.vscode/
.idea/
*.swp
*.swo

# Python (for any cron scripts)
__pycache__/
*.pyc
.venv/
venv/

# Node (if you add anything JS-y)
node_modules/

# Generated tailored resumes
*.tailored.pdf
*.tailored.docx
